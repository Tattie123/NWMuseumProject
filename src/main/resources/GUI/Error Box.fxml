<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.GUI.ErrorController"
            prefHeight="200.0" prefWidth="400.0">

    <children>
        <VBox spacing="10.0" alignment="CENTER" AnchorPane.topAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.bottomAnchor="10.0">
            <children>
                <Label fx:id="titleLabel" text="Error" style="-fx-font-size:16px; -fx-font-weight: bold;" />
                <TextArea fx:id="messageArea" editable="false" wrapText="true" prefRowCount="6" />
                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <children>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="copyButton" text="Copy" onAction="#handleCopy" />
                        <Button text="Close" onAction="#handleClose" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>

</AnchorPane>
